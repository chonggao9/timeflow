{
  "expo": {
    "name": "TimeFlow",
    "slug": "timeflow",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#FF6B6B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.chonggao.timeflow",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "打卡时记录您的位置"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF6B6B"
      },
      "package": "com.chonggao.timeflow",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "REPLACE_WITH_YOUR_GOOGLE_MAPS_ANDROID_KEY"
        }
      },
      "versionCode": 21
    },
    "plugins": [
      "./plugins/withRemoveMediaPermissions",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "打卡时记录您的位置"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "用于将行程小票长图保存至手机相册",
          "savePhotosPermission": "用于将行程小票长图保存至手机相册"
        }
      ],
      "expo-localization",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableBundleCompression": true,
            "extraProguardRules": "-keep class com.facebook.react.** { *; }\\n-keep class com.facebook.soloader.** { *; }\\n-keep class com.facebook.soloader.nativeloader.** { *; }\\n-keep class expo.modules.** { *; }\\n-keep class * extends expo.modules.kotlin.modules.Module { <init>(...); public <methods>; }\\n-keep class com.timeflow.amap.** { *; }\\n-keep class com.amap.api.location.** { *; }\\n-keep class com.reactnativeandroidwidget.** { *; }"
          }
        }
      ],
      "./plugins/withAbiFilter",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "TimeFlowWidget",
              "label": "TimeFlow 打卡",
              "description": "一键打卡 + 今日状态",
              "minWidth": "250dp",
              "minHeight": "120dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-secure-store",
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "783e66e6-d879-4baa-b536-ad9eafc15d4d"
      }
    },
    "owner": "chaselis-team"
  }
}
