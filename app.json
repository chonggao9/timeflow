{
  "expo": {
    "name": "TimeFlow",
    "slug": "timeflow",
    "version": "1.0.12",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#FF6B6B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.timeflow.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "打卡时记录您的位置"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FF6B6B"
      },
      "package": "com.timeflow.app",
      "navigationBar": {
        "backgroundColor": "#FBF5EF",
        "barStyle": "dark-content"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "打卡时记录您的位置"
        }
      ],
      "expo-localization",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableBundleCompression": true
          }
        }
      ],
      "./plugins/withAbiFilter"
    ],
    "extra": {
      "eas": {
        "projectId": "783e66e6-d879-4baa-b536-ad9eafc15d4d"
      }
    },
    "owner": "chaselis-team"
  }
}
