{
  "expo": {
    "name": "TimeFlow",
    "slug": "timeflow",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FF6B6B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.timeflow.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "打卡时记录您的位置"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FF6B6B"
      },
      "package": "com.timeflow.app"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "打卡时记录您的位置"
        }
      ],
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "ded83229-7c7b-4810-b5c9-548bdd306ce1"
      }
    },
    "owner": "chaseli"
  }
}
