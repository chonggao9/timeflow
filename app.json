{
  "expo": {
    "name": "TimeFlow",
    "slug": "timeflow",
    "scheme": "timeflow",
    "version": "1.2.7",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF5EF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.chonggao.timeflow",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "打卡时记录您的位置"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F63437"
      },
      "package": "com.chonggao.timeflow",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "REPLACE_WITH_YOUR_GOOGLE_MAPS_ANDROID_KEY"
        }
      },
      "versionCode": 29
    },
    "plugins": [
      "./plugins/withRemoveMediaPermissions",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "打卡时记录您的位置"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "用于将行程小票长图保存至手机相册",
          "savePhotosPermission": "用于将行程小票长图保存至手机相册"
        }
      ],
      "expo-localization",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableBundleCompression": true,
            "extraProguardRules": "-keep class com.facebook.react.** { *; }\n-keep class com.facebook.soloader.** { *; }\n-keep class com.facebook.soloader.nativeloader.** { *; }\n-keep class expo.modules.** { *; }\n-keep class * extends expo.modules.kotlin.modules.Module { <init>(...); public <methods>; }\n-keep class com.timeflow.amap.** { *; }\n-keep class com.amap.api.location.** { *; }\n-keep class com.reactnativeandroidwidget.** { *; }"
          }
        }
      ],
      "./plugins/withAbiFilter",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "PomodoroWidget4x2",
              "label": "番茄专注 · 完整版",
              "description": "番茄钟：开始/暂停/重置/切模式",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            },
            {
              "name": "PomodoroWidget4x1",
              "label": "番茄专注 · 迷你条",
              "description": "紧凑条形番茄钟：剩余时间与进度条",
              "minWidth": "250dp",
              "minHeight": "40dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "updatePeriodMillis": 1800000
            },
            {
              "name": "PomodoroWidget2x2",
              "label": "番茄专注 · 圆环",
              "description": "整卡点击开始/暂停",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            },
            {
              "name": "PomodoroWidgetTomato2x2",
              "label": "番茄专注 · 番茄卡",
              "description": "番茄图形与剩余时间",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            },
            {
              "name": "PomodoroWidgetDark2x2",
              "label": "番茄专注 · 深色大字",
              "description": "深色超大数字与循环点",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            },
            {
              "name": "PomodoroWidgetStats2x2",
              "label": "番茄专注 · 今日统计",
              "description": "今日专注分钟数与周柱状图",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            },
            {
              "name": "TravelWidget4x2",
              "label": "行程打卡 · 今日行程",
              "description": "一键打卡 + 今日足迹时间轴",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            },
            {
              "name": "TravelWidget4x1",
              "label": "行程打卡 · 下一站",
              "description": "下一站与快捷打卡",
              "minWidth": "250dp",
              "minHeight": "40dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "updatePeriodMillis": 1800000
            },
            {
              "name": "TravelWidgetWeek4x1",
              "label": "行程打卡 · 本周连续",
              "description": "连续天数与周打卡状态",
              "minWidth": "250dp",
              "minHeight": "40dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "updatePeriodMillis": 1800000
            },
            {
              "name": "TravelWidget2x2",
              "label": "行程打卡 · 一键打卡",
              "description": "整卡点击一键打卡",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            },
            {
              "name": "TravelWidgetMap2x2",
              "label": "行程打卡 · 足迹地图",
              "description": "今日足迹路线与打卡点",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            },
            {
              "name": "TravelWidgetHeat2x2",
              "label": "行程打卡 · 打卡热力",
              "description": "深色连续打卡天数与近四周热力图",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            },
            {
              "name": "TimeFlowWidget",
              "label": "TimeFlow 打卡（旧版）",
              "description": "已升级：请改用新版番茄专注/行程打卡组件",
              "minWidth": "250dp",
              "minHeight": "120dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-secure-store",
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "783e66e6-d879-4baa-b536-ad9eafc15d4d"
      }
    },
    "owner": "chaselis-team"
  }
}
